# Bricks and Context - Tuning / Optional configuration
# Copy into your .env as needed. Keep auth/workspaces in env.auth.template.

# ---- Connection pool ----
MAX_CONNECTIONS=10
HEALTH_CHECK_CACHE_TTL=300

# ---- SQL safety ----
# By default only read-only queries are allowed.
ALLOW_WRITE_QUERIES=false
MAX_RESULT_ROWS=200
MAX_RESULT_BYTES=262144
MAX_CELL_CHARS=200
ENABLE_SQL_RETRIES=true

# ---- Query caching ----
ENABLE_QUERY_CACHE=false
QUERY_CACHE_TTL_SECONDS=300

# ---- Jobs API ----
DATABRICKS_API_TIMEOUT_SECONDS=30

# ---- Logging ----
DATABRICKS_LOG_LEVEL=INFO

