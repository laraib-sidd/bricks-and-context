# Databricks MCP Server Configuration
# Copy this file to .env and fill in your actual values

# ===============================================
# 🚨 REQUIRED - MUST BE CONFIGURED
# ===============================================
# These values are absolutely necessary for the server to work

# Databricks workspace hostname (without https://)
# Example: your-workspace.cloud.databricks.com
DATABRICKS_HOST=your-workspace.cloud.databricks.com

# Databricks personal access token or service principal token
# Get from: Databricks Console > User Settings > Developer > Access Tokens
DATABRICKS_TOKEN=dapi1234567890abcdef...

# SQL Warehouse HTTP path (found in SQL Warehouse connection details)
# Format: /sql/1.0/warehouses/[warehouse-id]
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/abcd1234567890ef

# ===============================================
# ⚡ RECOMMENDED - HIGH IMPACT OPTIMIZATIONS
# ===============================================
# These significantly improve performance and should be enabled

# Enable intelligent caching system (reduces database load by 90%)
ENABLE_CACHING=true

# Enable health check caching (prevents SELECT 1 spam)
ENABLE_HEALTH_CHECK_CACHING=true
HEALTH_CHECK_CACHE_TTL=300

# Enable performance monitoring for insights
ENABLE_PERFORMANCE_MONITORING=true

# Basic retry logic for reliability
ENABLE_RETRY_LOGIC=true
MAX_RETRY_ATTEMPTS=3

# ===============================================
# 🔧 OPTIONAL - CONNECTION TUNING
# ===============================================
# Adjust these based on your workload

# Maximum database connections (default: 10)
# Increase for high concurrent AI usage
MAX_CONNECTIONS=10

# Connection timeout in seconds (default: 30)
CONNECTION_TIMEOUT=30

# SQL query timeout in seconds (default: 300)
SQL_QUERY_TIMEOUT=300

# ===============================================
# 📊 OPTIONAL - CACHE OPTIMIZATION
# ===============================================
# Fine-tune caching behavior for your needs

# Maximum cache entries before eviction (default: 1000)
CACHE_MAX_ENTRIES=1000

# Cache TTL values in seconds (defaults shown)
CACHE_SCHEMA_TTL=1800       # Schema info: 30 minutes
CACHE_TABLE_TTL=900         # Table metadata: 15 minutes
CACHE_QUERY_TTL=300         # Query results: 5 minutes
CACHE_JOB_TTL=120          # Job info: 2 minutes
CACHE_CONNECTION_TTL=60     # Connection status: 1 minute

# Maximum result size to cache in MB (default: 10)
MAX_CACHE_RESULT_SIZE_MB=10

# ===============================================
# 🛡️ OPTIONAL - RELIABILITY FEATURES
# ===============================================
# Advanced error handling and circuit breakers

# Enable circuit breaker protection
ENABLE_CIRCUIT_BREAKERS=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5      # Failures before opening
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60.0    # Seconds before retry
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=3      # Successes to close

# Retry configuration fine-tuning
RETRY_BASE_DELAY=1.0        # Base delay between retries
RETRY_MAX_DELAY=60.0        # Maximum delay between retries
RETRY_EXPONENTIAL_BASE=2.0  # Exponential backoff multiplier
RETRY_JITTER=true          # Add jitter to prevent thundering herd

# ===============================================
# 📝 OPTIONAL - LOGGING CONFIGURATION
# ===============================================
# Control what gets logged

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# INFO recommended for production, DEBUG for troubleshooting
DATABRICKS_LOG_LEVEL=INFO

# Enable specific log categories (true/false)
LOG_CACHE_OPERATIONS=true      # Cache hits/misses
LOG_PERFORMANCE_METRICS=true   # Performance stats
LOG_CIRCUIT_BREAKER=true       # Circuit breaker changes
LOG_RETRY_ATTEMPTS=true        # Retry attempts

# ===============================================
# 🗄️ OPTIONAL - DATABASE DEFAULTS
# ===============================================
# Default catalog and schema for queries

DEFAULT_CATALOG=main
DEFAULT_SCHEMA=default

# ===============================================
# 🔬 ADVANCED - EXPERT CONFIGURATION
# ===============================================
# Only modify if you know what you're doing

# Performance monitoring configuration
PERFORMANCE_MAX_METRICS=10000           # Max metrics to store
PERFORMANCE_RETENTION_SECONDS=3600      # How long to keep metrics
PERFORMANCE_SAMPLING_RATE=1.0           # Monitor sampling (0.0-1.0)

# Development and debugging flags
CACHE_FORCE_MISS=false                  # Force cache misses for testing
PERFORMANCE_DEBUG_MODE=false            # Detailed performance logs
CIRCUIT_BREAKER_TEST_MODE=false         # Sensitive circuit breakers

# ===============================================
# 📚 EXAMPLE CONFIGURATIONS
# ===============================================

# 🚀 HIGH-PERFORMANCE AI WORKLOADS:
# MAX_CONNECTIONS=20
# CACHE_MAX_ENTRIES=5000  
# PERFORMANCE_MAX_METRICS=50000
# RETRY_MAX_ATTEMPTS=5
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=10

# 💾 MEMORY-CONSTRAINED ENVIRONMENTS:
# MAX_CONNECTIONS=5
# CACHE_MAX_ENTRIES=500
# PERFORMANCE_MAX_METRICS=1000
# MAX_CACHE_RESULT_SIZE_MB=5

# 🧪 DEVELOPMENT/TESTING:
# DATABRICKS_LOG_LEVEL=DEBUG
# PERFORMANCE_DEBUG_MODE=true
# LOG_CACHE_OPERATIONS=true

# ===============================================
# 🎯 QUICK START CONFIGURATION
# ===============================================
# For most users, just set the REQUIRED values above
# and these recommended optimizations:

# ENABLE_CACHING=true
# ENABLE_HEALTH_CHECK_CACHING=true
# HEALTH_CHECK_CACHE_TTL=300
# ENABLE_PERFORMANCE_MONITORING=true
# ENABLE_RETRY_LOGIC=true 