# Databricks Connection Configuration
# Copy this file to .env and fill in your actual values

# ===============================================
# CORE DATABRICKS CONNECTION (REQUIRED)
# ===============================================

# Databricks workspace hostname (without https://)
DATABRICKS_HOST=your-workspace.cloud.databricks.com

# Databricks personal access token or service principal token
DATABRICKS_TOKEN=dapi1234567890abcdef...

# SQL Warehouse HTTP path (found in SQL Warehouse connection details)
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/abcd1234567890ef

# ===============================================
# CONNECTION POOL CONFIGURATION (OPTIONAL)
# ===============================================

# Maximum number of database connections in the pool
# Higher values support more concurrent AI requests
# Default: 10
MAX_CONNECTIONS=10

# Health check cache TTL in seconds (Phase 2.2 optimization)
# How long to cache connection health status to reduce SELECT 1 queries
# Default: 300 (5 minutes)
HEALTH_CHECK_CACHE_TTL=300

# ===============================================
# CACHE CONFIGURATION (PHASE 2.2)
# ===============================================

# Maximum number of cache entries before eviction
# Higher values = more memory usage but better hit rates
# Default: 1000
CACHE_MAX_ENTRIES=1000

# Default cache TTL values in seconds (can be overridden per category)
CACHE_HEALTH_TTL=300        # Health check cache (5 minutes)
CACHE_SCHEMA_TTL=1800       # Schema information cache (30 minutes)  
CACHE_TABLE_TTL=900         # Table metadata cache (15 minutes)
CACHE_QUERY_TTL=300         # Query result cache (5 minutes)
CACHE_JOB_TTL=120          # Job information cache (2 minutes)
CACHE_CONNECTION_TTL=60     # Connection status cache (1 minute)

# ===============================================
# PERFORMANCE MONITORING (PHASE 2.2)
# ===============================================

# Maximum number of performance metrics to store
# Higher values = more detailed performance history
# Default: 10000
PERFORMANCE_MAX_METRICS=10000

# Performance metric retention period in seconds
# How long to keep detailed operation metrics
# Default: 3600 (1 hour)
PERFORMANCE_RETENTION_SECONDS=3600

# ===============================================
# ERROR HANDLING & RETRY LOGIC (PHASE 2.2)
# ===============================================

# Default retry configuration
RETRY_MAX_ATTEMPTS=3        # Maximum retry attempts for failed operations
RETRY_BASE_DELAY=1.0        # Base delay between retries in seconds
RETRY_MAX_DELAY=60.0        # Maximum delay between retries in seconds
RETRY_EXPONENTIAL_BASE=2.0  # Exponential backoff multiplier
RETRY_JITTER=true          # Add random jitter to prevent thundering herd

# Circuit breaker configuration
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5      # Failures before opening circuit
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60.0    # Seconds before trying recovery
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=3      # Successes needed to close circuit

# ===============================================
# LOGGING CONFIGURATION
# ===============================================

# Log levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG: Detailed debugging info including cache hits/misses
# INFO: General operational information (recommended)
# WARNING: Important issues that don't stop operation
# ERROR: Error conditions that may affect functionality
DATABRICKS_LOG_LEVEL=INFO

# Enable/disable specific log categories (true/false)
LOG_CACHE_OPERATIONS=true      # Log cache hits, misses, and evictions
LOG_PERFORMANCE_METRICS=true   # Log slow operations and performance stats
LOG_CIRCUIT_BREAKER=true       # Log circuit breaker state changes
LOG_RETRY_ATTEMPTS=true        # Log retry attempts and failures

# ===============================================
# DATABASE DEFAULTS (OPTIONAL)
# ===============================================

# Default catalog and schema for queries
DEFAULT_CATALOG=main
DEFAULT_SCHEMA=default

# ===============================================
# ADVANCED CONFIGURATION (OPTIONAL)
# ===============================================

# SQL query timeout in seconds
# How long to wait for SQL queries before timing out
# Default: 300 (5 minutes)
SQL_QUERY_TIMEOUT=300

# Connection timeout in seconds
# How long to wait when establishing new connections
# Default: 30
CONNECTION_TIMEOUT=30

# Maximum query result size for caching (in MB)
# Large results won't be cached to prevent memory issues
# Default: 10
MAX_CACHE_RESULT_SIZE_MB=10

# Performance monitoring sampling rate (0.0 to 1.0)
# 1.0 = monitor all operations, 0.1 = monitor 10% of operations
# Default: 1.0 (monitor everything)
PERFORMANCE_SAMPLING_RATE=1.0

# ===============================================
# PHASE 2.2 FEATURE FLAGS (OPTIONAL)
# ===============================================

# Enable/disable Phase 2.2 features (true/false)
ENABLE_CACHING=true            # Enable intelligent caching system
ENABLE_PERFORMANCE_MONITORING=true  # Enable performance metrics collection
ENABLE_CIRCUIT_BREAKERS=true   # Enable circuit breaker protection
ENABLE_RETRY_LOGIC=true        # Enable automatic retry for failed operations
ENABLE_HEALTH_CHECK_CACHING=true  # Enable health check result caching

# ===============================================
# DEVELOPMENT & DEBUGGING (OPTIONAL)
# ===============================================

# Force cache misses for testing (true/false)
# When true, cache will be bypassed for all operations
# Default: false
CACHE_FORCE_MISS=false

# Performance monitoring debug mode (true/false)
# When true, detailed performance logs will be generated
# Default: false
PERFORMANCE_DEBUG_MODE=false

# Circuit breaker test mode (true/false)  
# When true, circuit breakers will be more sensitive for testing
# Default: false
CIRCUIT_BREAKER_TEST_MODE=false

# ===============================================
# EXAMPLE PRODUCTION CONFIGURATION
# ===============================================

# For high-performance AI workloads:
# MAX_CONNECTIONS=20
# CACHE_MAX_ENTRIES=5000
# PERFORMANCE_MAX_METRICS=50000
# RETRY_MAX_ATTEMPTS=5
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=10

# For memory-constrained environments:
# MAX_CONNECTIONS=5
# CACHE_MAX_ENTRIES=500
# PERFORMANCE_MAX_METRICS=1000
# MAX_CACHE_RESULT_SIZE_MB=5

# For development/testing:
# DATABRICKS_LOG_LEVEL=DEBUG
# PERFORMANCE_DEBUG_MODE=true
# LOG_CACHE_OPERATIONS=true
# CACHE_FORCE_MISS=false 